{
  "input_dir": "work/input",
  "output_dir": "work/output",
  "temp_dir": "work/temp",
  "jobs_root": "work/jobs",
  "clip_settings": {
    "format": "parts",
    "clip_length_seconds": 60,
    "overlap_seconds": 2,
    "max_clips_per_video": 40,
    "min_tail_seconds": 10
  },
  "tiktok": {
    "enabled": true,
    "width": 1080,
    "height": 1920,
    "mode": "crop",
    "smart_detect_every_n_frames": 5,
    "smart_smoothing_alpha": 0.25
  },
  "encoder": {
    "video": "auto",
    "nvenc_preset": "p4",
    "nvenc_cq": 23,
    "x264_preset": "veryfast",
    "x264_crf": 23
  },
  "captions": {
    "style": "part_label",
    "font_file": "C:/Windows/Fonts/arial.ttf",
    "font_size": 56,
    "font_color": "white",
    "box_color": "black@0.5",
    "margin_px": 120,
    "show_title": true,
    "title_max_chars": 40
  },
  "logging": { "level": "INFO" },
  "watcher": { "poll_interval_seconds": 5 },
  "retries": { "max_retries": 3 }
}
