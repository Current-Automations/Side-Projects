{
  "name": "job-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Daily routine that finds matching jobs, de-duplicates them, and drafts a tailored resume + cover letter for human review. No auto-apply.",
  "type": "module",
  "scripts": {
