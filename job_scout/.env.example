# --- Job Scout (standalone scripts only) ---------------------------------
# The real system is the scheduled routine in ROUTINE_PROMPT.md. It runs inside
# Claude Code with the Notion connector, generates documents itself, and reads
# the repo directly — so it needs NO API keys and ignores this file entirely.
#
# The two knobs below only apply if you run the .ts scripts directly for local
# testing against the local JSON tracker. Copy this file to ".env" if you do.

# How many NEW jobs to fully process per run.
JOB_SCOUT_MAX_JOBS_PER_RUN=3

# Local JSON tracker path (standalone runs only).
TRACKER_JSON_PATH=./tracker.local.json
